<Window x:Class="ArkSwitch.Windows.LaunchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="ArkSwitch"
        Width="360" Height="170"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True"
        FontFamily="Microsoft YaHei UI">
    <Border Background="{DynamicResource RegionBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="12" Padding="26,18">
        <StackPanel VerticalAlignment="Center">
            <hc:LoadingCircle Width="52" Height="52" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="正在启动…"
                       FontSize="13" Margin="0,12,0,0"
                       TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>
        </StackPanel>
    </Border>
</Window>
