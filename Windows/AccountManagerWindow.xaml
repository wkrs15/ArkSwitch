<hc:Window x:Class="ArkSwitch.Windows.AccountManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Style="{StaticResource WindowWin10}"
        Title="账号管理"
        Width="430" Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <!-- 通知容器放在独立覆盖层，不参与内容布局，避免弹出通知时挤压界面 -->
    <Grid>
        <Grid Margin="16,10,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="11"
                       Text="双击账号可重命名；切换前会先关闭正在运行的游戏"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>

            <ListBox Grid.Row="1" x:Name="AccountList" Margin="0,8,0,0"
                     MouseDoubleClick="AccountList_DoubleClick"/>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="新增" Width="66" Height="28" Margin="3,0" Click="Add_Click"/>
                <Button Content="删除" Width="66" Height="28" Margin="3,0" Click="Delete_Click"/>
                <Button Content="重命名" Width="66" Height="28" Margin="3,0" Click="Rename_Click"/>
                <Button Content="设为默认" Width="66" Height="28" Margin="3,0" Click="SetDefault_Click"/>
            </WrapPanel>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackupBtn" Content="备份当前账号" Height="34" Margin="0,0,5,0"
                        Click="Backup_Click"/>
                <Button x:Name="SwitchBtn" Grid.Column="1" Content="切换到选中账号" Height="34" Margin="5,0,0,0"
                        Style="{StaticResource ButtonPrimary}" Click="Switch_Click"/>
            </Grid>
        </Grid>

        <StackPanel hc:Growl.GrowlParent="True" hc:Growl.Token="ArkSwitchAccounts"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,34,8,0" Panel.ZIndex="100"/>
    </Grid>
</hc:Window>
