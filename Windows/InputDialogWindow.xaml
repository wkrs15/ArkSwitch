<hc:Window x:Class="ArkSwitch.Windows.InputDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Style="{StaticResource WindowWin10}"
        Title="输入"
        Width="400" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Microsoft YaHei UI">
    <StackPanel Margin="20,14,20,16">
        <TextBlock x:Name="PromptText" Text="请输入" FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryTextBrush}"/>
        <TextBox x:Name="InputBox" Height="30" Margin="0,12,0,0" VerticalContentAlignment="Center"
                 KeyDown="InputBox_KeyDown"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="确定" Width="80" Height="30" Click="Ok_Click"/>
            <Button Content="取消" Width="80" Height="30" Margin="12,0,0,0" Click="Cancel_Click"/>
        </StackPanel>
    </StackPanel>
</hc:Window>
