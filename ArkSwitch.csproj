<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ArkSwitch</RootNamespace>
		<AssemblyName>ArkSwitch</AssemblyName>
		<AssemblyTitle>ArkSwitch - 明日方舟切服/账号切换</AssemblyTitle>
		<Product>ArkSwitch</Product>
		<Version>1.7.0.0</Version>
		<FileVersion>1.7.0.0</FileVersion>
		<Copyright>基于 lTinchl/ArknightsLauncher (MIT) 重写</Copyright>
		<!-- Debug 用 asInvoker 清单方便开发调试，Release 要求管理员（写游戏目录/硬链接/结束进程需要） -->
		<ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.dev.manifest</ApplicationManifest>
		<ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<!-- 发布模式：依赖框架（framework-dependent）。产物仅几 MB，
		     要求用户安装 .NET 8 桌面运行时；缺失时 Windows 会弹窗引导下载。
		     RollForward 允许在已安装更高版本（如 .NET 10）运行时上直接运行 -->
		<SelfContained>false</SelfContained>
		<RollForward>LatestMajor</RollForward>
		<!-- 单文件发布；依赖框架模式下产物本身就只有几 MB -->
		<PublishSingleFile>true</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="HandyControls" Version="3.7.0" />
	</ItemGroup>

	<!-- 仓库与构建产物不包含任何游戏资源（load/ 切服文件），
	     用户首次启动或点击「更新切服文件」时由软件从官方 CDN 自动下载 -->

	<ItemGroup>
		<!-- tests 目录是独立测试项目，排除出主项目的默认编译通配 -->
		<Compile Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\app.ico" />
	</ItemGroup>

</Project>
